# Copy to .env to override defaults.

# Your Mac's LAN IP (ipconfig getifaddr en0) — baked into the HTTPS certificate
# so https://<ip>:8443 matches. Regenerated automatically when this changes.
DIANA_LAN_IP=

# Where Ollama lives. Empty = auto-detect (host Ollama first, then container).
OLLAMA_URL=

# Diana's own brain (planning, conversation, evaluation).
DIANA_MODEL=qwen3.6:latest

# The model worker agents run on (smaller = faster task execution).
WORKER_MODEL=mistral:latest

# Speech-to-text model size: tiny | base | small | medium
STT_MODEL=base

# Text-to-speech: piper (local) | edge (cloud, free) | off (browser voice)
TTS_ENGINE=piper
TTS_VOICE=en_US-lessac-medium

# How many worker agents run tasks at the same time.
WORKER_CONCURRENCY=2
